		"pi-package",
		"pi",
		"pi-extension",
		"retry",
		"timeout",
		"sentinel",
		"same-cause",
		"ai-agent"
	],
	"author": {
		"name": "liyihang866",
		"url": "https://github.com/liyihang866"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/liyihang866/pi-retry-sentinel.git"
	},
	"homepage": "https://github.com/liyihang866/pi-retry-sentinel",
	"bugs": {
		"url": "https://github.com/liyihang866/pi-retry-sentinel/issues"
	},
	"files": [
		"extensions/",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"pi": {
		"extensions": [
			"./extensions/retry-sentinel.ts"
		]
	},
	"peerDependencies": {
